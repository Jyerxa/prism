{
  "name": "prism-glass",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @prism/demo --",
    "build": "npm run build --workspace @prism/demo --",
    "preview": "npm run preview --workspace @prism/demo --",
    "start": "npm run preview",
    "storybook": "npm run dev --workspace @prism/storybook --",
    "build-storybook": "npm run build --workspace @prism/storybook --",
    "build:all": "npm run build --workspaces --if-present",
    "lint": "oxlint apps packages/ui/src/components/prism packages/ui/src/components/ui/slider.tsx packages/ui/src/lib tests vitest.config.ts",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@prism/ui": "*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "^4.1.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  }
}
